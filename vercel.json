{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "site/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["site/public/**", "site/downloads/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "site/server.js" }
  ]
}
