#!/bin/sh
##############################################################################
##
##  Gradle start up script for UN*X
##
##############################################################################

APP_HOME=$(cd "$(dirname "$0")" && pwd)

# ग누 resolvable java
if [ -n "$JAVA_HOME" ] ; then
    javacmd="$JAVA_HOME/bin/java"
else
    javacmd=$(command -v java || true)
fi

if [ -z "$javacmd" ] ; then
    echo "لم يتم العثور على جافا (java). رجاءً ثبت JDK 17+` وأعد المحاولة." >&2
    exit 1
fi

WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "ملف غلاف غرادل غير موجود. نفّذ الأمر: gradle wrapper (أو افتح المشروع في Android Studio)" >&2
    exit 1
fi

exec "$javacmd" -Xmx64m -jar "$WRAPPER_JAR" "$@"
