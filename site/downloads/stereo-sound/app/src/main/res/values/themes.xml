<resources>
    <style name="Theme.StereoSound" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryDark">@color/brand_paper</item>
        <item name="colorAccent">@color/brand_red</item>
        <item name="android:windowBackground">@color/brand_paper</item>
        <item name="android:statusBarColor">@color/brand_paper</item>
        <item name="android:navigationBarColor">@color/brand_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="StereoCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@drawable/comic_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">17dp</item>
        <item name="android:paddingEnd">21dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">19dp</item>
    </style>
    <style name="StereoSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="StereoHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/brand_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="StereoControlLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="StereoButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="android:background">@drawable/comic_button_cream</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="StereoSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layoutDirection">ltr</item>
        <item name="android:progressDrawable">@drawable/comic_seek_track</item>
        <item name="android:thumb">@drawable/comic_seek_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
    </style>
</resources>
