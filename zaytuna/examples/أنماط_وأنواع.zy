# الأنماط + الأدوية العامة + الأنواع
# تُشطب الأنواع في جافاسكربت، وتبقى كاملة مع:  zaytuna بناء examples/أنماط_وأنواع.zy --ts

دالة صنّف(قيمة) {
  طابق (قيمة) {
    مع ٠:
      أرجع "صفر"
    مع ١، ٢، ٣:
      أرجع "صغير"
    مع من ٤ إلى ١٠:
      أرجع "متوسط"
    مع نوع "string":
      أرجع "نصّ: " + قيمة
    مع [أ، ب]:
      أرجع "زوج مجموعه " + (أ + ب)
    مع {اسم، عمر}:
      أرجع اسم + " عمره " + عمر
    مع 99 إذا (صحيح):
      أرجع "حالة بشرط"
    غير_ذلك:
      أرجع "غير معروف"
  }
}

اطبع(صنّف(٠))
اطبع(صنّف(٢))
اطبع(صنّف(٧))
اطبع(صنّف("زيتونة"))
اطبع(صنّف([١٠، ٢٠]))
اطبع(صنّف({ اسم: "سارة"، عمر: ٣٠ }))
اطبع(صنّف(99))
اطبع(صنّف(١٠٠٠))

# أدوية عامة: دالة تعمل مع أي نوع، والأنواع تُشطب في جافاسكربت
دالة هوية عام <س>(قيمة: س): س {
  أرجع قيمة
}

صنف صندوق عام <س> {
  منشئ(عناصر: قائمة<س>) { هذا.العناصر = عناصر }
  دالة الأول(): س | عدم { أرجع هذا.العناصر[0] }
  دالة الحجم(): عدد { أرجع طول(this.العناصر) }
}

ثابت أرقام = جديد صندوق([١٠، ٢٠، ٣٠])
ثابت نصّي = جديد صندوق(["أ", "ب"])
اطبع(هوية(أرقام.الأول()))
اطبع(هوية(نصّي.الحجم()))

# الشرط الثلاثي بالعربية
متغير الدرجة = ٨٧
اطبع(الدرجة >= ٥٠ ؟ "ناجح" : "راسب")
