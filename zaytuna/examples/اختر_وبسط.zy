# اختيار متعدد + بسط/تجميع + دوال سهمية + أدوات نصية
دالة جمع(انشر الأعداد) {
  متغير المجموع = 0
  لكل عدد في الأعداد { المجموع += عدد }
  أرجع المجموع
}
اطبع("جمع(١، ٢، ٣، ٤) = " + جمع(انشر [١، ٢، ٣، ٤]))

متغير الدرجة = ٨٧
اختر (صحيح) {
  حالة الدرجة >= 90:
    اطبع("التقدير: ممتاز")
    كسر
  حالة الدرجة >= 80:
    اطبع("التقدير: جيد جدًا")
    كسر
  غير_ذلك:
    اطبع("التقدير: يحتاج مراجعة")
}

ثابت الضاعف = (س) => س * 2
اطبع("ضعف ٢١ = " + الضاعف(٢١))
اطبع("وصل: " + انضم(اقسم("زيتونة-لغة-عربية"، "-")، " + "))
اطبع("هل تحتوي «زيتونة» على «زيت»؟ " + يحتوي("زيتونة"، "زيت"))
