# حاسبة زيتونة — تعرض: الدوال، الشروط، الحلقات، المصفوفات، الأصناف، والدوال المدمجة.

دالة اجمع(أ، ب) {
  أرجع أ + ب
}

دالة صنّف(العدد) {
  إذا (العدد > 10) { أرجع "كبير" }
  وإلا إذا (العدد > 5) { أرجع "متوسط" }
  وإلا { أرجع "صغير" }
}

// الأرقام العربية مقبولة في الأعداد وتُحوَّل تلقائيًا إلى 0-9
ثابت الأعداد = [١، ٢، ٣، ٤، ٥]

متغير المجموع = 0
لكل عدد في الأعداد {
  المجموع += عدد
}

اطبع("مجموع الأعداد = " + المجموع)
اطبع("طول القائمة = " + طول(الأعداد))
اطبع("تصنيف المجموع: " + صنّف(المجموع))
اطبع("اجمع(٤٠، ٢) = " + اجمع(40، 2))

صنف مركبة {
  منشئ(الاسم، السرعة) {
    هذا.الاسم = الاسم
    هذا.السرعة = السرعة
  }
  دالة صف() {
    أرجع هذا.الاسم + " تسير بسرعة " + هذا.السرعة + " كم/س"
  }
}

ثابت سيارة = جديد مركبة("صهيل"، ١٢٠)
اطبع(سيارة.صف())

// حلقة كرر الكلاسيكية + دالة سهمية
كرر (متغير i = 1; i <= 3; i++) {
  اطبع("مربع " + i + " = " + [1,2,3].map((س) => س * س)[i - 1])
}
