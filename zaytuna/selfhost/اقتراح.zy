# ==========================================================================
#  زيتونة تكتب زيتونة — أول جزء حقيقي من الأداة مكتوب بلغة زيتونة نفسها
#  «مقترح الكلمات المفتاحية»: التطبيع العربي + مسافة ليفنشتاين + قاعدة الاقتراح
#  يُستخدم فعليًا في الأمر:  zaytuna اقترح <كلمة>
#  ويُقارَن سلوكه مع تنفيذ جافاسكربت في الاختبارات (يجب أن يتطابقا تمامًا).
# ==========================================================================

# تطبيع عربي: حذف التشكيل والتطويل وتوحيد الألف/الياء/التاء المربوطة
دالة طبيع(كلمة) {
  متغير نص = كلمة.normalize("NFKC")
  متغير الناتج = ""
  متغير فهرس = 0
  طالما (فهرس < طول(نص)) {
    متغير حرف = نص[فهرس]
    متغير الرمز = حرف.codePointAt(0)
    فهرس++
    # التشكيل (1611..1631) والمدّة 1648 والتطويل 1600 — تُحذف
    إذا (الرمز >= 1611 و الرمز <= 1631) { استمر }
    إذا (الرمز == 1648 أو الرمز == 1600) { استمر }
    # توحيد الأشكال
    إذا (الرمز == 1571 أو الرمز == 1573 أو الرمز == 1570 أو الرمز == 1649) { حرف = "ا" }
    إذا (الرمز == 1609 أو الرمز == 1740) { حرف = "ي" }
    إذا (الرمز == 1577) { حرف = "ه" }
    إذا (الرمز == 1705) { حرف = "ك" }
    الناتج += حرف
  }
  أرجع الناتج
}

# مسافة ليفنشتاين بين نصّين (نفس خوارزمية تنفيذ جافاسكربت)
دالة مسافة(أ، ب) {
  متغير م = طول(أ)
  متغير ن = طول(ب)
  إذا (م == 0) { أرجع ن }
  إذا (ن == 0) { أرجع م }

  متغير السابق = []
  متغير ع = 0
  طالما (ع <= ن) {
    أضف(السابق، ع)
    ع++
  }

  متغير أنا = 1
  طالما (أنا <= م) {
    متغير الحالي = [أنا]
    متغير ي = 1
    طالما (ي <= ن) {
      متغير التكلفة = 0
      إذا (أ[أنا - 1] != ب[ي - 1]) { التكلفة = 1 }
      متغير الأصغر = السابق[ي] + 1
      إذا (الحالي[ي - 1] + 1 < الأصغر) { الأصغر = الحالي[ي - 1] + 1 }
      إذا (السابق[ي - 1] + التكلفة < الأصغر) { الأصغر = السابق[ي - 1] + التكلفة }
      أضف(الحالي، الأصغر)
      ي++
    }
    السابق = الحالي
    أنا++
  }
  أرجع السابق[ن]
}

# اقتراح أقرب كلمة مفتاحية (نفس قاعدة تنفيذ جافاسكربت: حدّ ١ للقصيرة و٢ لغيرها)
دالة اقترح(كلمة، كلمات) {
  متغير نظيف = طبيع(كلمة)
  متغير الأفضل = عدم
  متغير أفضل = 999
  لكل مفتاح في كلمات {
    متغير د = مسافة(نظيف، طبيع(مفتاح))
    إذا (د < أفضل) {
      أفضل = د
      الأفضل = مفتاح
    }
  }
  متغير الحد = 1
  إذا (طول(نظيف) > 4) { الحد = 2 }
  إذا (أفضل <= الحد و أفضل < طول(نظيف)) { أرجع الأفضل }
  أرجع عدم
}
